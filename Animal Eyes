<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Through Their Eyes</title>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;800&family=Instrument+Sans:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#eef0f4;--ink:#14172b;--mut:#565b73;--card:#fff;--line:#d3d7e2;--acc:#e0a100;--on:#14172b;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#10122a;--ink:#eef0f8;--mut:#9aa0bd;--card:#1a1d3a;--line:#2d3160;--acc:#f2b705;--on:#10122a}}
:root[data-theme="dark"]{--bg:#10122a;--ink:#eef0f8;--mut:#9aa0bd;--card:#1a1d3a;--line:#2d3160;--acc:#f2b705;--on:#10122a}
*{box-sizing:border-box}
[hidden]{display:none!important}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.55 "Instrument Sans",system-ui,sans-serif}
main{max-width:980px;margin:0 auto;padding:20px 16px 40px}
h1{font:800 clamp(28px,6vw,48px)/1.05 "Bricolage Grotesque",system-ui,sans-serif;margin:8px 0 6px;letter-spacing:-.02em}
.sub{color:var(--mut);margin:0 0 18px;max-width:60ch}
.stage{position:relative;background:#000;border-radius:18px;overflow:hidden;aspect-ratio:4/3;border:1px solid var(--line)}
canvas{width:100%;height:100%;display:block;object-fit:cover}
.start{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;text-align:center;padding:24px;background:var(--bg)}
.start p{margin:0;max-width:42ch;color:var(--mut)}
button,label.btn{font:600 15px "Instrument Sans",sans-serif;background:var(--acc);color:#14172b;border:0;border-radius:999px;padding:12px 22px;cursor:pointer}
button.ghost,label.btn.ghost{background:transparent;color:var(--ink);border:1px solid var(--line)}
button:focus-visible,label.btn:focus-within{outline:3px solid var(--ink);outline-offset:2px}
.err{color:#c0392b;min-height:1.4em;font-size:14px}
.hud{position:absolute;left:12px;bottom:12px;background:rgba(0,0,0,.6);color:#fff;padding:6px 12px;border-radius:999px;font-size:13px}
.tools{position:absolute;right:10px;top:10px;display:flex;gap:8px}
.tools button{padding:8px 14px;font-size:13px;background:rgba(0,0,0,.55);color:#fff}
.eyes{display:flex;gap:10px;overflow-x:auto;padding:16px 2px 8px;scrollbar-width:thin}
.eye{flex:0 0 auto;display:flex;flex-direction:column;align-items:center;gap:6px;background:none;color:var(--ink);padding:6px;border-radius:14px;border:2px solid transparent;font-size:13px}
.eye[aria-pressed="true"]{border-color:var(--acc)}
.eye svg{width:64px;height:64px}
.info{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px 20px;margin-top:8px}
.info h2{font:800 24px "Bricolage Grotesque",sans-serif;margin:0 0 4px}
.info p{margin:6px 0;max-width:68ch}
.facts{display:flex;flex-wrap:wrap;gap:8px 24px;margin-top:10px;color:var(--mut);font-size:14px}
.facts b{color:var(--ink)}
.note{color:var(--mut);font-size:13px;margin-top:14px}
</style>
</head>
<body>
<main>
  <h1>Through their eyes</h1>
  <p class="sub">Point your camera at the room and see an approximation of how a dog, cat, bee, eagle, fly or snake would see it.</p>

  <div class="stage">
    <canvas id="out" width="640" height="480" aria-label="Camera view filtered to match the chosen animal"></canvas>
    <div class="start" id="start">
      <button id="go">Allow camera</button>
      <p>Video stays on your device. Nothing is recorded or uploaded.</p>
      <div class="err" id="err" role="alert"></div>
      <label class="btn">Take a photo<input id="file2" type="file" accept="image/*" capture="environment" hidden></label>
      <label class="btn ghost">Or choose a photo<input id="file" type="file" accept="image/*" hidden></label>
    </div>
    <div class="tools" id="tools" hidden><button id="flip" class="ghost">Switch camera</button></div>
    <div class="hud" id="hud" hidden></div>
  </div>

  <div class="eyes" id="eyes" role="group" aria-label="Choose an animal"></div>
  <div class="info" id="info"></div>
  <p class="note">These are scientific approximations: real animal vision depends on brain processing we can’t reproduce, and phone cameras can’t capture ultraviolet or infrared light.</p>
</main>

<script>
const ANIMALS=[
 {id:'human',name:'Human',pupil:'round',title:'Human',text:'Three colour receptors, sharp central vision and a forward-facing view. This is your baseline.',facts:['Colour: <b>trichromat</b>','Field of view: <b>~190°</b>','Sharpness: <b>20/20</b>']},
 {id:'dog',name:'Dog',pupil:'round',title:'Dog',text:'Dogs have two colour receptors, so reds and greens blur into yellowish browns while blues stay vivid. Their detail is softer than ours, but they notice motion very well.',facts:['Colour: <b>dichromat</b>','Field of view: <b>~240°</b>','Sharpness: <b>~20/75</b>']},
 {id:'cat',name:'Cat',pupil:'slit',title:'Cat',text:'Cats see dim scenes far better than we do, thanks to a reflective layer behind the retina. The price is softer detail and muted colour, mostly blues and greens.',facts:['Colour: <b>limited dichromat</b>','Field of view: <b>~200°</b>','Night vision: <b>~6× better</b>']},
 {id:'bee',name:'Bee',pupil:'hex',title:'Honeybee',text:'Bees can’t see red, but they see ultraviolet, which reveals hidden patterns on flowers. Their compound eyes give a coarse, mosaic image. UV is shown here as violet.',facts:['Colour: <b>UV, blue, green</b>','Field of view: <b>~280°</b>','Sharpness: <b>very low</b>']},
 {id:'eagle',name:'Eagle',pupil:'round',title:'Eagle',text:'Eagles have a dense cluster of receptors and a deep fovea, resolving detail about four times finer than a human. The view here is zoomed and enhanced, with richer colour.',facts:['Colour: <b>tetrachromat</b>','Field of view: <b>~340°</b>','Sharpness: <b>~20/5</b>']},
 {id:'fly',name:'Fly',pupil:'hex',title:'Housefly',text:'A fly’s compound eyes are made of thousands of tiny lenses, each seeing one dot of the scene. Detail is low, but they process motion several times faster than we do.',facts:['Colour: <b>UV + visible</b>','Field of view: <b>~360°</b>','Motion: <b>~250 images/sec</b>']},
 {id:'snake',name:'Pit viper',pupil:'slit',title:'Pit viper',text:'Pit vipers combine ordinary eyesight with a heat-sensing pit organ between eye and nostril. This view maps brightness to a heat palette as a stand-in for infrared.',facts:['Sense: <b>infrared + visible</b>','Field of view: <b>~200°</b>','Hunts: <b>in total darkness</b>']}
];
const out=document.getElementById('out'),octx=out.getContext('2d');
const src=document.createElement('canvas');src.width=320;src.height=240;
const sctx=src.getContext('2d',{willReadFrequently:true});
const vid=document.createElement('video');vid.playsInline=true;vid.muted=true;
let cur=ANIMALS[0],stream=null,facing='environment',still=null,t0=performance.now(),last=0;

function pupilSVG(p){
 const iris='<circle cx="32" cy="32" r="28" fill="#e0a100" stroke="currentColor" stroke-width="2"/>';
 const shapes={round:'<circle cx="32" cy="32" r="13" fill="#14172b"/>',slit:'<ellipse cx="32" cy="32" rx="4.5" ry="22" fill="#14172b"/>',hex:'<polygon points="32,12 49,22 49,42 32,52 15,42 15,22" fill="#14172b"/>'};
 return '<svg viewBox="0 0 64 64" aria-hidden="true">'+iris+shapes[p]+'<circle cx="38" cy="26" r="3" fill="#fff" opacity=".8"/></svg>';
}
const eyes=document.getElementById('eyes');
ANIMALS.forEach(a=>{
 const b=document.createElement('button');b.className='eye';b.innerHTML=pupilSVG(a.pupil)+'<span>'+a.name+'</span>';
 b.setAttribute('aria-pressed',a===cur);b.onclick=()=>pick(a);a.btn=b;eyes.appendChild(b);
});
function pick(a){
 cur=a;ANIMALS.forEach(x=>x.btn.setAttribute('aria-pressed',x===a));
 out.style.filter={dog:'blur(1.6px)',cat:'blur(2.4px) brightness(1.25) contrast(1.1)',bee:'blur(1px)',eagle:'saturate(1.5) contrast(1.15)',snake:'blur(1.8px)'}[a.id]||'none';
 document.getElementById('info').innerHTML='<h2>'+a.title+'</h2><p>'+a.text+'</p><div class="facts">'+a.facts.map(f=>'<span>'+f+'</span>').join('')+'</div>';
 const h=document.getElementById('hud');h.textContent='Seeing as: '+a.title;
}
pick(cur);

function heat(v){ // 0..1 -> black, purple, red, yellow, white
 const s=[[0,0,0],[60,0,110],[200,20,40],[255,190,0],[255,255,230]];
 const x=Math.min(.999,Math.max(0,v))*4,i=x|0,f=x-i,a=s[i],b=s[i+1];
 return [a[0]+(b[0]-a[0])*f,a[1]+(b[1]-a[1])*f,a[2]+(b[2]-a[2])*f];
}
function grab(){
 const w=src.width,h=src.height;
 const el=still||vid;const sw=still?still.width:vid.videoWidth,sh=still?still.height:vid.videoHeight;
 if(!sw)return false;
 let z=cur.id==='eagle'?1.7:1;
 let cw=sw/z,ch=sh/z;const r=w/h;
 if(cw/ch>r)cw=ch*r;else ch=cw/r;
 sctx.drawImage(el,(sw-cw)/2,(sh-ch)/2,cw,ch,0,0,w,h);
 return true;
}
function frame(now){
 requestAnimationFrame(frame);
 if(now-last<33)return;last=now;
 if(!grab())return;
 const w=src.width,h=src.height,id=cur.id;
 const img=sctx.getImageData(0,0,w,h),d=img.data;
 for(let i=0;i<d.length;i+=4){
  const r=d[i],g=d[i+1],b=d[i+2];
  if(id==='dog'){d[i]=.625*r+.375*g;d[i+1]=.7*g+.3*r;d[i+2]=.3*g+.7*b;}
  else if(id==='cat'){const m=.5*r+.5*g;d[i]=.4*m+.1*b+.2*r;d[i+1]=.5*m+.3*g;d[i+2]=.6*b+.3*m;}
  else if(id==='bee'){const uv=Math.max(0,b-.4*g);d[i]=uv*.55+g*.1;d[i+1]=g*.85;d[i+2]=Math.min(255,b*.8+uv*.5);}
  else if(id==='eagle'){const m=(r+g+b)/3;d[i]=m+(r-m)*1.3;d[i+1]=m+(g-m)*1.3;d[i+2]=m+(b-m)*1.3;}
  else if(id==='snake'){const l=(.3*r+.59*g+.11*b)/255,c=heat(l*l*1.2+.05*Math.sin(l*9));d[i]=c[0];d[i+1]=c[1];d[i+2]=c[2];}
 }
 sctx.putImageData(img,0,0);
 const W=out.width,H=out.height;
 if(id==='fly'||id==='bee'){
  const s=id==='fly'?15:22,rad=s*.6;
  octx.fillStyle='#000';octx.fillRect(0,0,W,H);
  const rowH=s*.866,sx=W/w,sy=H/h;
  const px=sctx.getImageData(0,0,w,h).data;
  for(let row=0,y=rowH/2;y<H+s;row++,y+=rowH){
   for(let x=(row%2?s/2:0);x<W+s;x+=s){
    const ix=Math.min(w-1,(x/sx)|0),iy=Math.min(h-1,(y/sy)|0),k=(iy*w+ix)*4;
    octx.fillStyle='rgb('+px[k]+','+px[k+1]+','+px[k+2]+')';
    octx.beginPath();octx.arc(x,y,rad,0,6.283);octx.fill();
   }
  }
 }else{
  octx.imageSmoothingEnabled=true;octx.drawImage(src,0,0,W,H);
 }
 if(id==='cat'||id==='dog'){ // soft vignette for wide-set eyes
  const g=octx.createRadialGradient(W/2,H/2,H*.35,W/2,H/2,H*.85);
  g.addColorStop(0,'rgba(0,0,0,0)');g.addColorStop(1,'rgba(0,0,0,.55)');octx.fillStyle=g;octx.fillRect(0,0,W,H);
 }
}
requestAnimationFrame(frame);

function ready(){
 document.getElementById('start').hidden=true;
 document.getElementById('hud').hidden=false;
 document.getElementById('tools').hidden=!stream;
}
async function startCam(){
 const err=document.getElementById('err');err.textContent='';
 if(!navigator.mediaDevices||!navigator.mediaDevices.getUserMedia){err.textContent='This browser can’t access a camera. Choose a photo instead.';return;}
 try{
  if(stream)stream.getTracks().forEach(t=>t.stop());
  stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:{ideal:facing},width:{ideal:1280}},audio:false});
  vid.srcObject=stream;await vid.play();still=null;ready();
 }catch(e){
  err.textContent=(e&&e.name==='NotAllowedError')?'Camera access was blocked. Allow it in your browser’s site settings, then try again, or choose a photo.':'No camera could be started. Choose a photo instead.';
 }
}
document.getElementById('go').onclick=startCam;
document.getElementById('flip').onclick=()=>{facing=facing==='user'?'environment':'user';startCam();};
document.getElementById('file2').onchange=e=>document.getElementById('file').onchange(e);
document.getElementById('file').onchange=e=>{
 const f=e.target.files[0];if(!f)return;
 const im=new Image();im.onload=()=>{if(stream){stream.getTracks().forEach(t=>t.stop());stream=null;}still=im;ready();};
 im.src=URL.createObjectURL(f);
};
</script>
</body>
</html>
